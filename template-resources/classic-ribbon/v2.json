{
  "schemaVersion": 2,
  "version": 2,
  "renderContract": "declarative-flow@1",
  "assets": [],
  "templateId": "classic-ribbon",
  "capabilities": [
    "flow",
    "local-grid",
    "vector-shapes",
    "skill-meter"
  ],
  "tokens": {
    "primary": "#4f7483",
    "accent": "#c1a065"
  },
  "appearanceDefaults": {
    "theme": {
      "theme": "default"
    },
    "font": {
      "fontFamily": "noto-sans-sc",
      "fontSize": 15
    },
    "spacing": {
      "pageMargin": 24,
      "sectionSpacing": 16,
      "lineHeight": 1.6
    }
  },
  "styles": {
    "document": {
      "color": {
        "token": "text"
      },
      "lineHeight": {
        "token": "lineHeight"
      }
    },
    "sectionList": {
      "gap": {
        "token": "sectionSpacing"
      }
    },
    "blocks": {
      "gap": {
        "token": "entrySpacing"
      }
    },
    "entries": {
      "gap": {
        "token": "entrySpacing"
      }
    },
    "entry": {
      "gap": {
        "token": "paragraphSpacing"
      }
    },
    "body": {
      "fontSize": {
        "token": "contentSize"
      },
      "fontWeight": {
        "token": "normalWeight"
      },
      "color": {
        "token": "text"
      },
      "lineHeight": {
        "token": "lineHeight"
      }
    },
    "tagList": {
      "gap": 8
    },
    "tag": {
      "fontSize": {
        "token": "smallSize"
      },
      "color": {
        "token": "text"
      },
      "borderColor": {
        "token": "primary"
      },
      "borderWidth": 1,
      "borderRadius": 999,
      "paddingLeft": 8,
      "paddingRight": 8,
      "paddingTop": 4,
      "paddingBottom": 4
    },
    "banner": {
      "gap": 14,
      "paddingLeft": 4,
      "paddingRight": 4,
      "paddingBottom": 18,
      "alignItems": "center",
      "color": {
        "token": "primary"
      }
    },
    "bannerTitle": {
      "fontSize": {
        "token": "nameSize",
        "factor": 1.6
      },
      "fontWeight": {
        "token": "normalWeight"
      },
      "whiteSpace": "nowrap",
      "flexShrink": 0
    },
    "bannerSubtitle": {
      "borderLeftWidth": 1,
      "borderColor": {
        "token": "primary"
      },
      "paddingLeft": 14
    },
    "slogan": {
      "fontSize": {
        "token": "smallSize"
      },
      "lineHeight": {
        "token": "lineHeight"
      }
    },
    "englishTitle": {
      "fontSize": {
        "token": "nameSize"
      },
      "lineHeight": 1.3
    },
    "icons": {
      "justifyContent": "end",
      "gap": 8,
      "flexGrow": 1
    },
    "icon": {
      "width": 36,
      "height": 36,
      "flexShrink": 0
    },
    "stripe": {
      "height": 15,
      "marginBottom": 12
    },
    "profile": {
      "marginLeft": 14,
      "paddingLeft": 18,
      "paddingBottom": {
        "token": "sectionSpacing"
      },
      "borderLeftWidth": 1,
      "borderColor": {
        "token": "primary"
      }
    },
    "main": {
      "marginLeft": 14,
      "paddingLeft": 18,
      "borderLeftWidth": 1,
      "borderColor": {
        "token": "primary"
      }
    },
    "profileFields": {
      "columns": [
        1,
        1
      ],
      "columnGap": 28,
      "rowGap": {
        "token": "paragraphSpacing"
      }
    },
    "profileField": {
      "alignItems": "baseline",
      "gap": 4,
      "fontSize": {
        "token": "contentSize"
      },
      "color": {
        "token": "secondary"
      }
    },
    "profileLabel": {
      "minWidth": {
        "token": "contentSize",
        "factor": 5
      },
      "flexShrink": 0
    },
    "profileValue": {
      "minWidth": 0
    },
    "ribbonHeading": {
      "marginLeft": -33,
      "marginBottom": 12,
      "borderBottomWidth": 1,
      "borderColor": {
        "token": "primary"
      }
    },
    "ribbonLabel": {
      "paddingLeft": 22,
      "paddingRight": 42,
      "fontSize": {
        "token": "fontSize"
      },
      "fontWeight": {
        "token": "mediumWeight"
      },
      "color": "#ffffff",
      "lineHeight": 1.6
    },
    "entryHead": {
      "columns": [
        1,
        1.5,
        1
      ],
      "gap": 16,
      "alignItems": "baseline",
      "fontSize": {
        "token": "contentSize"
      },
      "fontWeight": {
        "token": "boldWeight"
      },
      "color": {
        "token": "text"
      }
    },
    "entryTitle": {
      "textAlign": "center"
    },
    "entrySubtitle": {
      "textAlign": "right"
    },
    "skillGrid": {
      "columns": [
        1,
        1,
        1
      ],
      "gap": {
        "token": "entrySpacing"
      }
    },
    "skill": {
      "fontSize": {
        "token": "contentSize"
      },
      "color": {
        "token": "text"
      },
      "gap": 4
    },
    "meterRow": {
      "alignItems": "center",
      "gap": 8
    },
    "meter": {
      "height": 6,
      "borderRadius": 999,
      "minWidth": 0,
      "flexGrow": 1
    },
    "percentage": {
      "fontSize": {
        "token": "smallSize"
      },
      "color": {
        "token": "muted"
      },
      "flexShrink": 0
    }
  },
  "document": [
    {
      "id": "document",
      "type": "box",
      "layout": "stack",
      "children": [
        {
          "id": "profile",
          "type": "box",
          "layout": "stack",
          "children": [
            {
              "id": "banner",
              "type": "box",
              "layout": "row",
              "children": [
                {
                  "id": "banner-title",
                  "type": "text",
                  "text": "个人简历",
                  "style": "bannerTitle"
                },
                {
                  "id": "banner-subtitles",
                  "type": "box",
                  "layout": "stack",
                  "children": [
                    {
                      "id": "banner-slogan",
                      "type": "text",
                      "text": "认真准备，奔赴热爱",
                      "style": "slogan"
                    },
                    {
                      "id": "banner-english",
                      "type": "text",
                      "text": "Personal resume",
                      "style": "englishTitle"
                    }
                  ],
                  "style": "bannerSubtitle"
                },
                {
                  "id": "banner-icons",
                  "type": "box",
                  "layout": "row",
                  "children": [
                    {
                      "id": "education-icon",
                      "type": "shape",
                      "style": "icon",
                      "viewBox": [
                        0,
                        0,
                        36,
                        36
                      ],
                      "shapes": [
                        {
                          "kind": "circle",
                          "cx": 18,
                          "cy": 18,
                          "radius": 18,
                          "fill": {
                            "token": "accent"
                          }
                        },
                        {
                          "kind": "path",
                          "d": "M7 15 L18 9 L29 15 L18 21 Z M11 18 V24 Q18 29 25 24 V18 M29 15 V24",
                          "stroke": "#ffffff",
                          "strokeWidth": 1.6
                        }
                      ]
                    },
                    {
                      "id": "work-icon",
                      "type": "shape",
                      "style": "icon",
                      "viewBox": [
                        0,
                        0,
                        36,
                        36
                      ],
                      "shapes": [
                        {
                          "kind": "circle",
                          "cx": 18,
                          "cy": 18,
                          "radius": 18,
                          "fill": {
                            "token": "accent"
                          }
                        },
                        {
                          "kind": "rect",
                          "x": 8,
                          "y": 13,
                          "width": 20,
                          "height": 15,
                          "radius": 2,
                          "stroke": "#ffffff",
                          "strokeWidth": 1.6
                        },
                        {
                          "kind": "path",
                          "d": "M14 13 V9 H22 V13 M8 19 Q18 24 28 19 M18 20 V23",
                          "stroke": "#ffffff",
                          "strokeWidth": 1.6
                        }
                      ]
                    }
                  ],
                  "style": "icons"
                }
              ],
              "style": "banner",
              "atomic": true
            },
            {
              "id": "banner-stripe",
              "type": "shape",
              "style": "stripe",
              "viewBox": [
                0,
                0,
                1000,
                15
              ],
              "shapes": [
                {
                  "kind": "rect",
                  "x": 0,
                  "y": 0,
                  "width": 1000,
                  "height": 15,
                  "fill": {
                    "token": "accent"
                  }
                },
                {
                  "kind": "path",
                  "d": "M0 0 H623 L640 15 H0 Z",
                  "fill": "#ffffff"
                },
                {
                  "kind": "path",
                  "d": "M0 0 H613 L630 15 H0 Z",
                  "fill": {
                    "token": "primary"
                  }
                }
              ]
            },
            {
              "id": "profile-details",
              "type": "box",
              "layout": "stack",
              "children": [
                {
                  "id": "profile-heading",
                  "type": "box",
                  "layout": "row",
                  "children": [
                    {
                      "id": "profile-title",
                      "type": "box",
                      "layout": "row",
                      "children": [
                        {
                          "id": "profile-heading-text",
                          "type": "text",
                          "text": "基本信息"
                        }
                      ],
                      "style": "ribbonLabel",
                      "atomic": true,
                      "viewBox": [
                        0,
                        0,
                        240,
                        26
                      ],
                      "decoration": [
                        {
                          "kind": "path",
                          "d": "M0 0 H210 L240 26 H0 Z",
                          "fill": {
                            "token": "primary"
                          }
                        },
                        {
                          "kind": "path",
                          "d": "M206 0 L235 26 M214 0 L243 26",
                          "stroke": "#ffffff",
                          "strokeWidth": 2
                        },
                        {
                          "kind": "path",
                          "d": "M0 26 H18 V34 Z",
                          "fill": {
                            "token": "primary"
                          }
                        }
                      ]
                    }
                  ],
                  "style": "ribbonHeading",
                  "atomic": true
                },
                {
                  "id": "profile-fields",
                  "type": "repeat",
                  "source": "profile.fields",
                  "layout": "grid",
                  "children": [
                    {
                      "id": "profile-field",
                      "type": "box",
                      "layout": "row",
                      "children": [
                        {
                          "id": "profile-label",
                          "type": "box",
                          "layout": "row",
                          "children": [
                            {
                              "id": "profile-label-text",
                              "type": "text",
                              "binding": "item.label"
                            },
                            {
                              "id": "profile-label-colon",
                              "type": "text",
                              "text": "："
                            }
                          ],
                          "style": "profileLabel"
                        },
                        {
                          "id": "profile-value",
                          "type": "field",
                          "binding": "item",
                          "style": "profileValue"
                        }
                      ],
                      "style": "profileField",
                      "atomic": true
                    }
                  ],
                  "style": "profileFields",
                  "fieldOrder": [
                    "name",
                    "age",
                    "workYears",
                    "jobIntent",
                    "intentionalCity",
                    "expectedSalary",
                    "dateEntry",
                    "phone",
                    "email",
                    "nativePlace"
                  ]
                }
              ],
              "style": "profile"
            }
          ],
          "when": {
            "binding": "profile",
            "operator": "present"
          },
          "sectionTarget": "basics"
        },
        {
          "id": "main",
          "type": "box",
          "layout": "stack",
          "children": [
            {
              "id": "sections",
              "type": "sections",
              "style": "sectionList"
            }
          ],
          "style": "main"
        }
      ],
      "style": "document"
    }
  ],
  "section": [
    {
      "id": "section",
      "type": "box",
      "layout": "stack",
      "children": [
        {
          "id": "section-heading",
          "type": "box",
          "layout": "row",
          "children": [
            {
              "id": "section-title",
              "type": "box",
              "layout": "row",
              "children": [
                {
                  "id": "section-heading-text",
                  "type": "text",
                  "binding": "section.title"
                }
              ],
              "style": "ribbonLabel",
              "atomic": true,
              "viewBox": [
                0,
                0,
                240,
                26
              ],
              "decoration": [
                {
                  "kind": "path",
                  "d": "M0 0 H210 L240 26 H0 Z",
                  "fill": {
                    "token": "primary"
                  }
                },
                {
                  "kind": "path",
                  "d": "M206 0 L235 26 M214 0 L243 26",
                  "stroke": "#ffffff",
                  "strokeWidth": 2
                },
                {
                  "kind": "path",
                  "d": "M0 26 H18 V34 Z",
                  "fill": {
                    "token": "primary"
                  }
                }
              ]
            }
          ],
          "style": "ribbonHeading",
          "atomic": true
        },
        {
          "id": "section-blocks",
          "type": "blocks",
          "style": "blocks"
        }
      ]
    }
  ],
  "contentByKind": {
    "experience": [
      {
        "id": "experience-items",
        "type": "repeat",
        "source": "block.items",
        "layout": "stack",
        "children": [
          {
            "id": "experience-entry",
            "type": "box",
            "layout": "stack",
            "children": [
              {
                "id": "experience-head",
                "type": "box",
                "layout": "grid",
                "children": [
                  {
                    "id": "experience-duration",
                    "type": "field",
                    "binding": "item.duration"
                  },
                  {
                    "id": "experience-title",
                    "type": "field",
                    "binding": "item.title",
                    "style": "entryTitle"
                  },
                  {
                    "id": "experience-subtitle",
                    "type": "field",
                    "binding": "item.subtitle",
                    "style": "entrySubtitle"
                  }
                ],
                "style": "entryHead",
                "atomic": true
              },
              {
                "id": "experience-description",
                "type": "richText",
                "binding": "item.description",
                "style": "body"
              }
            ],
            "style": "entry"
          }
        ],
        "style": "entries"
      }
    ],
    "richText": [
      {
        "id": "rich-text-content",
        "type": "richText",
        "binding": "block.richText",
        "style": "body"
      }
    ],
    "skills": [
      {
        "id": "skills-items",
        "type": "repeat",
        "source": "block.items",
        "layout": "grid",
        "children": [
          {
            "id": "skill",
            "type": "box",
            "layout": "stack",
            "children": [
              {
                "id": "skill-field",
                "type": "field",
                "binding": "item.field"
              },
              {
                "id": "skill-meter-row",
                "type": "box",
                "layout": "row",
                "children": [
                  {
                    "id": "skill-meter",
                    "type": "meter",
                    "binding": "item.percentage",
                    "track": {
                      "token": "track"
                    },
                    "fill": {
                      "token": "primary"
                    },
                    "style": "meter"
                  },
                  {
                    "id": "skill-percentage",
                    "type": "box",
                    "layout": "row",
                    "children": [
                      {
                        "id": "skill-percentage-number",
                        "type": "text",
                        "binding": "item.percentage"
                      },
                      {
                        "id": "skill-percentage-sign",
                        "type": "text",
                        "text": "%"
                      }
                    ],
                    "style": "percentage",
                    "when": {
                      "binding": "item.displayType",
                      "operator": "equals",
                      "value": "percentage"
                    }
                  }
                ],
                "style": "meterRow"
              }
            ],
            "style": "skill",
            "atomic": true
          }
        ],
        "style": "skillGrid"
      }
    ],
    "fieldList": [
      {
        "id": "field-list-items",
        "type": "repeat",
        "source": "block.items",
        "layout": "wrap",
        "children": [
          {
            "id": "field-list-tag",
            "type": "box",
            "layout": "row",
            "children": [
              {
                "id": "field-list-field",
                "type": "field",
                "binding": "item"
              }
            ],
            "style": "tag",
            "atomic": true
          }
        ],
        "style": "tagList"
      }
    ],
    "tagList": [
      {
        "id": "tag-list-items",
        "type": "repeat",
        "source": "block.items",
        "layout": "wrap",
        "children": [
          {
            "id": "tag-list-tag",
            "type": "box",
            "layout": "row",
            "children": [
              {
                "id": "tag-list-field",
                "type": "field",
                "binding": "item"
              }
            ],
            "style": "tag",
            "atomic": true
          }
        ],
        "style": "tagList"
      }
    ]
  }
}
